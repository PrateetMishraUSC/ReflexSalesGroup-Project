      "checkConstraints": {
        "lines_quantity_range": {
          "name": "lines_quantity_range",
          "value": "\"lines\".\"quantity\" IS NULL OR \"lines\".\"quantity\" BETWEEN 0 AND 1000000"
        },
        "lines_unit_cost_range": {
          "name": "lines_unit_cost_range",
          "value": "\"lines\".\"unit_cost\" IS NULL OR (\"lines\".\"unit_cost\" > 0 AND \"lines\".\"unit_cost\" <= 100000)"
        },
        "lines_retail_price_range": {
          "name": "lines_retail_price_range",
          "value": "\"lines\".\"retail_price\" IS NULL OR \"lines\".\"retail_price\" >= 0"
        },
        "lines_line_value_matches": {
          "name": "lines_line_value_matches",
          "value": "\"lines\".\"line_value\" IS NULL OR \"lines\".\"line_value\" = ROUND(\"lines\".\"quantity\" * \"lines\".\"unit_cost\", 2)"
        },
        "lines_retail_value_matches": {
          "name": "lines_retail_value_matches",
          "value": "\"lines\".\"retail_value\" IS NULL OR \"lines\".\"retail_value\" = ROUND(\"lines\".\"quantity\" * \"lines\".\"retail_price\", 2)"
        },
        "lines_included_is_complete": {
          "name": "lines_included_is_complete",
          "value": "\"lines\".\"status\" <> 'included' OR (\"lines\".\"item_code\" IS NOT NULL AND \"lines\".\"size\" IS NOT NULL AND \"lines\".\"quantity\" > 0 AND \"lines\".\"unit_cost\" IS NOT NULL AND \"lines\".\"line_value\" IS NOT NULL)"
        },
        "lines_excluded_has_reason": {
          "name": "lines_excluded_has_reason",
          "value": "\"lines\".\"status\" <> 'excluded' OR \"lines\".\"exclude_reason\" IS NOT NULL"
        }
